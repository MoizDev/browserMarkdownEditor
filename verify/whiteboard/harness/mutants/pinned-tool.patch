+import { DefaultToolbar, TldrawUiMenuItem, useTools } from 'tldraw';
+
+export default function B39PinnedToolbar() {
+    const tools = useTools();
+    return (
+        <DefaultToolbar>
+            <TldrawUiMenuItem {...tools.select} isSelected={true} />
+            <TldrawUiMenuItem {...tools.draw} isSelected={false} />
+        </DefaultToolbar>
+    );
+}
