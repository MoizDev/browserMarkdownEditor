# Local development only; this is the actual locked arm64 base, not the
# owner's future x86-64 ship image. Building creates a local image; do not
# publish it. Docker/BuildKit and network access are owner-controlled.
FROM --platform=linux/arm64 debian@sha256:ec8534cda2cb30f29f44f23e135297af7a1496f2990fd8e4e84aa36b081a757a
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC LC_ALL=C.UTF-8
COPY locks/os-installed.tsv /tmp/expected-os.tsv
# The pinned base may not yet contain CA certificates. Snapshot metadata is
# still authenticated by apt's Debian archive keyring and its package hashes.
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources && \
    printf '%s\n' \
      'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] http://snapshot.debian.org/archive/debian/20261101T000000Z/ bookworm main' \
      'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] http://snapshot.debian.org/archive/debian-security/20261101T000000Z/ bookworm-security main' \
      > /etc/apt/sources.list.d/locked-snapshot.list && \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates=20250419~deb12u2 curl=7.88.1-10+deb12u15 \
      git=1:2.39.5-0+deb12u3 python3=3.11.2-1+b1 xz-utils=5.4.1-1+deb12u2 \
      time=1.9-0.2 make=4.3-4.1 patch=2.7.6-7 unzip=6.0-28+deb12u1 file=1:5.44-3 && \
    dpkg-query -W -f='${binary:Package}\t${Version}\t${Architecture}\n' | LC_ALL=C sort > /tmp/actual-os.tsv && \
    LC_ALL=C sort /tmp/expected-os.tsv > /tmp/sorted-os.tsv && \
    cmp /tmp/sorted-os.tsv /tmp/actual-os.tsv && \
    rm -rf /var/lib/apt/lists/* /tmp/expected-os.tsv /tmp/actual-os.tsv /tmp/sorted-os.tsv
WORKDIR /work
